# cp .env.example .env  и заполнить. .env в git не коммитить.

# --- База (контейнер с Postgres в общей docker-сети) ---
DB_NETWORK=postgres_default   # имя docker-сети контейнера с Postgres
DB_HOST=postgres              # имя контейнера/сервиса Postgres в этой сети
DB_PORT=5432
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=change-me

# --- Telegram ---
BOT_TOKEN=

# --- GigaChat: либо AUTH_KEY, либо CLIENT_ID + CLIENT_SECRET ---
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_MODEL=GigaChat-2-Max

# --- Админка ---
ADMIN_USERNAME=admin
# bcrypt-хэш в ОДИНАРНЫХ кавычках, иначе compose съест $: ADMIN_PASSWORD_HASH='$2a$12$...'
ADMIN_PASSWORD_HASH=
ADMIN_TELEGRAM_ID=

# --- HTTPS-прокси админки (compose-сервис admin-proxy) ---
# IP или домен сервера; админка откроется на https://<ADMIN_PUBLIC_HOST>:<ADMIN_HTTPS_PORT>/admin
ADMIN_PUBLIC_HOST=
ADMIN_HTTPS_PORT=8443

# --- Прочее ---
BIND=127.0.0.1   # 0.0.0.0 — открыть наружу (только за TLS-прокси!)
PORT=8080
LOG_LEVEL=INFO
